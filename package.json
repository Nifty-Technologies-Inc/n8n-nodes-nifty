{
	"name": "@nifty-technologies/n8n-nodes-nifty",
	"version": "0.1.0",
	"description": "n8n community node for Nifty: tasks, projects, lists, labels and more, with polling triggers",
	"license": "MIT",
	"homepage": "https://developers.niftypm.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nifty-Technologies-Inc/n8n-nodes-nifty.git"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"nifty",
		"niftypm"
	],
	"author": {
		"name": "Nifty Technologies Inc",
		"email": "team@niftypm.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/NiftyOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Nifty/Nifty.node.js",
			"dist/nodes/Nifty/NiftyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
